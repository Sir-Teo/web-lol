     {
+        var paths = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string,string>>(File.ReadAllText("docs/reference/map-wad-paths.json"));
+        MetaSerializer.ReferenceWadPathResolver = hash => hash == 0 ? "" : paths.TryGetValue(hash.ToString("x16"), out var path) ? path : "unknown/" + hash.ToString("x16");
         MapGeometryGltfConversionContext conversionContext =
             new(
                 MetaEnvironment.Create(
@@ -122,6 +124,7 @@ class Program
         using FileStream materialsBinStream = File.OpenRead(options.MaterialsBinPath);
 
         using EnvironmentAsset mapGeometry = new(environmentAssetStream);
+        File.WriteAllText(".cache/map-mesh-info.json", System.Text.Json.JsonSerializer.Serialize(mapGeometry.Meshes.Select(m => new { m.Name, Visibility = (byte)m.VisibilityFlags, m.VisibilityControllerPathHash, m.RegionHash, BakedLight = m.BakedLight.Texture, StationaryLight = m.StationaryLight.Texture, Overrides = m.TextureOverrides.Select(t => t.Texture) })));
         BinTree materialsBin = new(materialsBinStream);
 
         mapGeometry.ToGltf(materialsBin, conversionContext).Save(options.GltfPath);
