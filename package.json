{
  "name": "web-lol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "assets:validate": "node tools/assets/validate-glb.mjs && node tools/assets/validate-map.mjs",
    "format": "prettier --write src tests e2e *.ts tools/assets/*.mjs",
    "test:production": "npm run build && node tools/qa/production-subpath.mjs"
  },
  "dependencies": {
    "three": "0.186.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^25.0.0",
    "@types/three": "^0.183.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
