  "findings": {
    "initialIntegrationFailure": "The first isolated GPU cases passed, while image review caught a dark rectangle in the actual opaque game canvas. A focused GL check reproduced error 1282 (invalid copy texture format combination).",
    "repair": "Match framebuffer storage to the actual WebGL context: RGB8 when alpha=false, RGBA8 otherwise. The repaired real-view identity copy is byte-exact, reports GL error zero, produces visible warp pixels and survives context recovery exactly.",
    "preservation": "Nine bc408cf evidence artifacts were frozen before regression execution, new outputs were archived under a unique prefix, and the original artifacts were restored and hash-verified. The prior hit verifier passed before updating current documentation."
  },
  "policies": {
    "native": "Original Metal/AIR bytes are canonical; installed clang statically decodes with LLVM passes disabled and retargets only the textual module to the host. No native execution claim.",
    "staging": "Copy the actual canvas and retain existing color/depth; the caller chooses the display list. No automatic E mode mapping.",
    "samplers": "Copy uses clamped linear filtering, no mipmaps and raw color space. Complete native runtime sampler setup remains unknown.",
    "ownership": "Empty/hidden lists allocate/copy/draw nothing and dispose prior storage; resize and real context loss recreate copies; geometry/material/images remain caller-owned.",
    "color": "RGB=lookup.rgb*tint.rgb*copied.rgb*base.rgb; alpha=normal.a*lookup.a. Displacement uses lookup alpha, without normal alpha or aspect scaling.",
    "coordinates": "Native divided screen coordinates interpolate perspectively; WebGL copy sampling reverses native top-left Y. Physical viewport rectangles handle pixel ratio and subviewports."
  },
