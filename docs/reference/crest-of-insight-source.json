  "strings": {
    "blueMonsterTooltip": {
      "rstHash": "46786458625",
      "value": "<titleLeft><font color='#FFCC00'>Blue Sentinel</font></titleLeft><subtitleRight>300 second respawn</subtitleRight><subtitleLeft>Large Monster - Buff</subtitleLeft><mainText>A powerful and durable melee attacker. When slain, grants the <u><font color='#FFCC00'>Crest of Insight</font></u> buff, which greatly increases Mana Regeneration and Cooldown Reduction for 2 minutes.</mainText>"
    },
    "buffName": {
      "rstHash": "258206257612",
      "value": "Crest of Insight"
    },
    "buffTooltip": {
      "rstHash": "259795327118",
      "value": "<titleLeft>Crest of Insight</titleLeft><mainText>Regenerates @f2@ + @f3@% max Mana and Energy every 5 seconds and has @f1@ Ability Haste.<br><br>If the buff holder is slain, this buff is transferred to their killer.</mainText><postScriptLeft>Source: @SourceName@</postScriptLeft>"
    }
  },
